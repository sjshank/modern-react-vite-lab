{
  "name": "vite-sample-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "type-check": "tsc -b",
    "build": "npm run assets:optimize && vite build",
    "build:analyze": "npm run build && npm run bundle:report",
    "bundle:report": "node scripts/bundle-report.mjs",
    "test:bundle": "node --test scripts/bundle-report.test.mjs",
    "test:delivery": "node --test scripts/delivery.test.mjs",
    "test:assets": "node --test scripts/assets.test.mjs scripts/optimize-assets.test.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "test:security": "node --test scripts/security.test.mjs",
    "security:check": "node scripts/check-client-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:ci": "npm run audit:dependencies && npm run test:bundle && npm run test:security && vite build && npm run security:check && npm run test:delivery",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run lint && npm run audit:dependencies && npm run test:bundle && npm run test:security && npm run build:analyze && npm run security:check && npm run test:delivery",
    "preview": "vite preview",
    "test:i18n": "vitest run src/tests/i18n.test.ts",
    "validate:i18n": "pnpm test:i18n && pnpm type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:production": "knip --production",
    "lhci:test": "npm run build && npm exec -- lhci autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.18.0",
    "@sentry/react": "^11.16.0",
    "i18next": "^27.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
